PORT=4000
CLIENT_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5431/codary_db?schema=public
JWT_SECRET=super_secret_jwt_key
JWT_EXPIRES_IN=7d
NODE_ENV=development

# DeepSeek API (OpenAI-compatible) — https://api-docs.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Models: deepseek-v4-flash (fast, default) | deepseek-v4-pro (higher quality)
DEEPSEEK_MODEL=deepseek-v4-flash
# Thinking mode: disabled (faster, cheaper chat) | enabled (chain-of-thought, default in V4 API)
DEEPSEEK_THINKING=disabled
# Used only when DEEPSEEK_THINKING=enabled: high | max
# DEEPSEEK_REASONING_EFFORT=high
# Used only when DEEPSEEK_THINKING=disabled
# DEEPSEEK_TEMPERATURE=0.7
# DEEPSEEK_MAX_TOKENS=1024
